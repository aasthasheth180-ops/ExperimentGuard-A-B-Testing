
# ExperimentGuard environment configuration
# Copy this file to .env and replace placeholders with your own values.
# Never commit the real .env file.

# PostgreSQL
DB_USER=your_postgres_username
DB_PASSWORD=replace_with_your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=experimentguard_db

# JWT authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret


# Comma-separated frontend origins
# For production, set this to the actual deployed frontend URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Application environment: development, test, or production
APP_ENV=development

# Production requires explicit HTTPS frontend origins.
# Example:
# CORS_ORIGINS=https://your-frontend.example.com


# Application logging
LOG_LEVEL=INFO